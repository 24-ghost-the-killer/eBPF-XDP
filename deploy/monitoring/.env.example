# Copy to .env (mode 0600). Generate with: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: bind Grafana to the server's private IP reachable via Twingate.
# Leave unset for localhost-only access through an SSH tunnel.
# GRAFANA_HTTP_ADDR=10.0.0.10
# true = dashboards viewable without login (read-only Viewer role), e.g. for a
# kiosk display on the host. Admin login still requires the password.
GRAFANA_ANONYMOUS_VIEWER=false
