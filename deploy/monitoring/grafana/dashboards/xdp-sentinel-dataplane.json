        {
          "datasource": {
            "type": "prometheus",
            "uid": "xs-prometheus"
          },
          "expr": "clamp_max(sum(rate(xs_verdict_packets_total{iface=~\"$iface\",verdict=\"drop\"}[$__rate_interval])) / clamp_min(sum(rate(xs_rx_packets_total{iface=~\"$iface\"}[$__rate_interval])), 1e-9), 1)",
