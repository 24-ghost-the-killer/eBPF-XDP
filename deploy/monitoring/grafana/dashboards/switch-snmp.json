{
  "uid": "xs-switch-snmp",
  "title": "Switch (SNMP)",
  "description": "Per-port throughput, packet rate, link status, errors and discards for the managed switch, polled via SNMP (IF-MIB).",
  "tags": ["xdp-sentinel", "switch", "snmp"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m"] },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Switch",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
        "query": { "query": "label_values(ifOperStatus, device)", "refId": "device" },
        "definition": "label_values(ifOperStatus, device)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": { "selected": false, "text": "gs1900-24hp", "value": "gs1900-24hp" }
      },
      {
        "name": "port",
        "label": "Port",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
        "query": { "query": "label_values(ifHCInOctets{device=\"$device\"}, ifName)", "refId": "port" },
        "definition": "label_values(ifHCInOctets{device=\"$device\"}, ifName)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Switch uptime",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "dtdurations", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "sysUpTime{device=\"$device\"} / 100", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ports up",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "count(ifOperStatus{device=\"$device\"} == 1)", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total in / out (bits/s)",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        { "refId": "IN", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "sum(rate(ifHCInOctets{device=\"$device\"}[$__rate_interval])) * 8", "legendFormat": "in" },
        { "refId": "OUT", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "sum(rate(ifHCOutOctets{device=\"$device\"}[$__rate_interval])) * 8", "legendFormat": "out" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Inbound throughput per port",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifHCInOctets{device=\"$device\", ifName=~\"$port\"}[$__rate_interval]) * 8", "legendFormat": "{{ifName}} {{ifDescr}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbound throughput per port",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifHCOutOctets{device=\"$device\", ifName=~\"$port\"}[$__rate_interval]) * 8", "legendFormat": "{{ifName}} {{ifDescr}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Packet rate per port (in + out)",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifHCInUcastPkts{device=\"$device\", ifName=~\"$port\"}[$__rate_interval]) + rate(ifHCOutUcastPkts{device=\"$device\", ifName=~\"$port\"}[$__rate_interval])", "legendFormat": "{{ifName}} {{ifDescr}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors + discards per port",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "fillOpacity": 0, "showPoints": "never", "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "IE", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifInErrors{device=\"$device\", ifName=~\"$port\"}[$__rate_interval])", "legendFormat": "{{ifName}} in-err" },
        { "refId": "OE", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifOutErrors{device=\"$device\", ifName=~\"$port\"}[$__rate_interval])", "legendFormat": "{{ifName}} out-err" },
        { "refId": "ID", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifInDiscards{device=\"$device\", ifName=~\"$port\"}[$__rate_interval])", "legendFormat": "{{ifName}} in-disc" },
        { "refId": "OD", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "rate(ifOutDiscards{device=\"$device\", ifName=~\"$port\"}[$__rate_interval])", "legendFormat": "{{ifName}} out-disc" }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Port status",
      "datasource": { "type": "prometheus", "uid": "xs-prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 0 }, "2": { "text": "down", "color": "red", "index": 1 }, "3": { "text": "testing", "color": "yellow", "index": 2 } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          { "matcher": { "id": "byName", "options": "Speed" }, "properties": [ { "id": "unit", "value": "Mbits" } ] }
        ]
      },
      "targets": [
        { "refId": "STATUS", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "ifOperStatus{device=\"$device\", ifName=~\"$port\"}", "instant": true, "format": "table" },
        { "refId": "SPEED", "datasource": { "type": "prometheus", "uid": "xs-prometheus" }, "expr": "ifHighSpeed{device=\"$device\", ifName=~\"$port\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "ifIndex", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "__name__ 1": true, "__name__ 2": true, "job 1": true, "job 2": true, "instance 1": true, "instance 2": true, "device 1": true, "device 2": true, "ifAlias 2": true, "ifDescr 2": true, "ifName 2": true },
            "renameByName": {
              "ifName 1": "Port",
              "ifDescr 1": "Description",
              "ifAlias 1": "Alias",
              "Value #STATUS": "Status",
              "Value #SPEED": "Speed"
            },
            "indexByName": { "ifName 1": 0, "ifDescr 1": 1, "ifAlias 1": 2, "Value #STATUS": 3, "Value #SPEED": 4 }
          }
        }
      ]
    }
  ]
}
