#!/usr/bin/env bash
# xs-ufw-sync - keep the service-allowlist (default-deny) for protected hosts
# in step with the box's own ufw ALLOW rules, with no manual command.
#
# Driven by two systemd units (both inert until enabled):
#   xdp-sentinel-ufw-sync.service  runs this once at boot, after the agent has
#                                  re-attached (pinned maps do not survive a
#                                  reboot, so default-deny must be re-applied).
#   xdp-sentinel-ufw-sync.path     re-runs the service whenever the ufw rules
#                                  file changes, i.e. on every `ufw allow/deny`.
#
# /etc/xdp-sentinel/protect.conf:  <ipv4> [iface]
#   One protected destination per line. `iface` defaults to every interface the
#   agent manages (read from config.toml). For each line the host's services
#   are mirrored from `ufw status` and the host is put in default-deny. Blank
#   lines and lines starting with # are ignored.
set -euo pipefail

CONF=${XS_CONFIG:-/etc/xdp-sentinel/config.toml}
PROTECT=${XS_PROTECT:-/etc/xdp-sentinel/protect.conf}
PIN_ROOT=${XS_PIN_ROOT:-/sys/fs/bpf/xdp-sentinel}
CTL=${XS_CTL:-/usr/local/bin/sentinelctl}

[ -r "$PROTECT" ] || { echo "xs-ufw-sync: no $PROTECT, nothing to sync"; exit 0; }

# Interfaces the agent manages, taken from the config's `name = "..."` entries.
managed_ifaces() { awk -F'"' '/^[[:space:]]*name[[:space:]]*=/{print $2}' "$CONF"; }

# The agent creates the pins when it attaches; on boot give it a moment.
wait_for_pin() { # iface
	local iface=$1 _
	for _ in $(seq 30); do
		[ -e "$PIN_ROOT/$iface/xs_service_v4" ] && return 0
		sleep 1
	done
	return 1
}

rc=0
while read -r ip iface _; do
	[ -n "$ip" ] || continue
	ifaces=${iface:-$(managed_ifaces)}
	for i in $ifaces; do
		if ! wait_for_pin "$i"; then
			# The dataplane is not loaded (or the agent has not re-attached
			# yet). Nothing to sync into; a later ufw change or boot will retry.
			# This is a soft skip, not a failure.
			echo "xs-ufw-sync: $i has no service map (dataplane not loaded?), skipped" >&2
			continue
		fi
		if "$CTL" service-sync -i "$i" "$ip" --protect; then
			echo "xs-ufw-sync: synced $ip on $i from ufw"
		else
			echo "xs-ufw-sync: sync failed for $ip on $i" >&2
			rc=1
		fi
	done
done < <(grep -vE '^[[:space:]]*(#|$)' "$PROTECT")

exit "$rc"
