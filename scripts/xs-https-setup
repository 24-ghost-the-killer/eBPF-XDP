#!/usr/bin/env bash
# =============================================================================
# xs-https-setup — serve the dashboard over HTTPS (nginx TLS reverse proxy)
# =============================================================================
# Moves the dashboard to HTTPS **on the same port** it has always used (3000),
# so Twingate resources, ufw and the XDP protection plan need no change:
#
#   browser --https--> nginx :3000 (TLS) --http--> Next.js 127.0.0.1:3002
#
#   * plain http://<box>:3000 is redirected to https://<box>:3000
#   * the app only listens on 127.0.0.1, so nothing can bypass TLS from the
#     network (and X-Forwarded-For from nginx can be trusted for the audit log
#     and the per-IP sign-in lock)
#   * certificates come from a small local CA made here: trust the CA once per
#     device (download https://<box>:3000/xdp-sentinel-ca.crt) and later
#     certificate renewals need no re-trusting. The leaf is renewed
#     automatically when < 30 days remain (re-run, or the timer below).
#   * the kiosk display on the box keeps using plain http://127.0.0.1:3002
#     (never leaves the machine, so no certificate warning)
#
# Run as root on the appliance:
#   sudo scripts/xs-https-setup               # enable / renew (idempotent)
#   sudo scripts/xs-https-setup --rollback    # back to plain http on :3000
#   sudo scripts/xs-https-setup --renew       # only renew the certificate if due
#                                             # (run monthly by xs-https-renew.timer)
# Options: --port 3000  --app-port 3002  --tls-dir /etc/xdp-sentinel/tls
# -----------------------------------------------------------------------------
set -euo pipefail

PORT=3000
APP_PORT=3002   # 3001 is taken by Grafana on the box
TLS_DIR=/etc/xdp-sentinel/tls
DASH_UNIT=xdp-dashboard
KIOSK=/home/test_server/start_kiosk.sh
ROLLBACK=no
RENEW_ONLY=no

c(){ printf '\033[%sm' "$1"; }
info(){ printf '   %s\n' "$*"; }
ok(){ printf '   %s✓%s %s\n' "$(c '1;32')" "$(c 0)" "$*"; }
warn(){ printf '%s!! %s%s\n' "$(c '1;33')" "$*" "$(c 0)" >&2; }
die(){ printf '%sxx %s%s\n' "$(c '1;31')" "$*" "$(c 0)" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2;;
    --app-port) APP_PORT="$2"; shift 2;;
    --tls-dir) TLS_DIR="$2"; shift 2;;
    --rollback) ROLLBACK=yes; shift;;
    --renew) RENEW_ONLY=yes; shift;;
    -h|--help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) die "unknown option: $1";;
  esac
done
[ "$(id -u)" -eq 0 ] || die "run as root (sudo)."

DROPIN_DIR=/etc/systemd/system/$DASH_UNIT.service.d
DROPIN=$DROPIN_DIR/https.conf
SITE=/etc/nginx/sites-available/xdp-sentinel
KIOSK_LOCAL="http://127.0.0.1:$APP_PORT"

wait_port() { for _ in $(seq 40); do curl -s -o /dev/null "http://127.0.0.1:$1/login" && return 0; sleep 0.5; done; return 1; }

# ---- rollback ---------------------------------------------------------------
if [ "$ROLLBACK" = yes ]; then
  rm -f /etc/nginx/sites-enabled/xdp-sentinel
  systemctl reload nginx 2>/dev/null || systemctl stop nginx 2>/dev/null || true
  rm -f "$DROPIN"
  systemctl disable --now xs-https-renew.timer 2>/dev/null || true
  rm -f /etc/systemd/system/xs-https-renew.service /etc/systemd/system/xs-https-renew.timer
  systemctl daemon-reload
  systemctl restart "$DASH_UNIT"
  wait_port "$PORT" && ok "dashboard back on plain http://<box>:$PORT" || warn "dashboard did not answer on :$PORT yet"
  if [ -f "$KIOSK" ]; then
    sed -i -E "s#http://127\.0\.0\.1:[0-9]+/api/kiosk#http://192.168.1.193:$PORT/api/kiosk#" "$KIOSK"
    pkill -u test_server -x firefox 2>/dev/null || true
  fi
  exit 0
fi

command -v apt-get >/dev/null || die "needs apt-get (Debian/Ubuntu)."
# The internal port must be free (on any address) unless it is our own dashboard
# from an earlier run — e.g. Grafana holds 192.168.1.193:3001 on the box.
if [ "$RENEW_ONLY" = no ] && [ -n "$(ss -ltnH "( sport = :$APP_PORT )" 2>/dev/null)" ] \
   && ! grep -qs -- "-p $APP_PORT " "$DROPIN"; then
  ss -ltnp "( sport = :$APP_PORT )" >&2
  die "port $APP_PORT is already in use by something else — pick a free one with --app-port N (nothing changed)."
fi
if [ "$RENEW_ONLY" = no ] && ! command -v nginx >/dev/null; then
  info "installing nginx…"
  apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nginx >/dev/null || die "could not install nginx."
  # Debian starts nginx with a default site on :80 — not wanted here.
  rm -f /etc/nginx/sites-enabled/default
fi
command -v openssl >/dev/null || die "need openssl."

# ---- certificates: local CA + server cert -----------------------------------
install -d -m0750 "$TLS_DIR"
CA_KEY=$TLS_DIR/ca.key; CA_CRT=$TLS_DIR/ca.crt
KEY=$TLS_DIR/dashboard.key; CRT=$TLS_DIR/dashboard.crt
if [ ! -s "$CA_KEY" ] || [ ! -s "$CA_CRT" ]; then
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
    -keyout "$CA_KEY" -out "$CA_CRT" -subj "/CN=xdp-sentinel local CA/O=xdp-sentinel" \
    -addext "basicConstraints=critical,CA:TRUE,pathlen:0" -addext "keyUsage=critical,keyCertSign,cRLSign" >/dev/null 2>&1 \
    || die "could not create the local CA."
  chmod 0600 "$CA_KEY"; chmod 0644 "$CA_CRT"
  ok "created local CA ($CA_CRT, 10 years)"
fi
need_leaf=yes
if [ -s "$CRT" ] && [ -s "$KEY" ] && openssl x509 -checkend $((30*86400)) -noout -in "$CRT" >/dev/null 2>&1 \
   && openssl verify -CAfile "$CA_CRT" "$CRT" >/dev/null 2>&1; then
  need_leaf=no
fi
if [ "$need_leaf" = yes ]; then
  SAN="DNS:$(hostname),DNS:localhost,IP:127.0.0.1"
  for ip in $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1); do SAN="$SAN,IP:$ip"; done
  tmp=$(mktemp -d)
  openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$tmp/k" -out "$tmp/csr" \
    -subj "/CN=xdp-sentinel dashboard" >/dev/null 2>&1 || die "could not create the key"
  printf 'subjectAltName=%s\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=serverAuth\n' "$SAN" > "$tmp/ext"
  # 397 days: the longest validity browsers accept for a server certificate.
  openssl x509 -req -in "$tmp/csr" -CA "$CA_CRT" -CAkey "$CA_KEY" -CAcreateserial -days 397 -sha256 \
    -extfile "$tmp/ext" -out "$tmp/c" >/dev/null 2>&1 || die "could not sign the certificate"
  install -m0640 -g www-data "$tmp/k" "$KEY"; install -m0644 "$tmp/c" "$CRT"; rm -rf "$tmp"
  ok "issued dashboard certificate (SAN: $SAN)"
  chgrp www-data "$TLS_DIR" 2>/dev/null || true
else
  ok "dashboard certificate valid for more than 30 days — kept"
fi
if [ "$RENEW_ONLY" = yes ]; then
  [ "$need_leaf" = yes ] && { systemctl reload nginx && ok "nginx reloaded with the new certificate"; }
  exit 0
fi

# ---- nginx site ---------------------------------------------------------------
# "http2 on;" exists from nginx 1.25.1; older nginx simply serves HTTP/1.1.
HTTP2=""
nv=$(nginx -v 2>&1 | sed -n 's#.*nginx/\([0-9.]*\).*#\1#p')
if [ -n "$nv" ] && [ "$(printf '%s\n1.25.1\n' "$nv" | sort -V | head -1)" = 1.25.1 ]; then HTTP2="    http2 on;"; fi
cat > "$SITE" <<EOF
# Managed by xs-https-setup — HTTPS for the xdp-sentinel dashboard.
server {
    listen $PORT ssl;
    listen [::]:$PORT ssl;
$HTTP2
    server_name _;

    ssl_certificate     $CRT;
    ssl_certificate_key $KEY;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:xssl:5m;

    # Plain http:// on this TLS port -> redirect to https:// (nginx code 497).
    error_page 497 =301 https://\$http_host\$request_uri;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    client_max_body_size 4m;
    proxy_read_timeout 75s;

    # The CA certificate, so devices can download and trust it once.
    location = /xdp-sentinel-ca.crt { default_type application/x-x509-ca-cert; alias $CA_CRT; }

    # Live updates (Server-Sent Events): no buffering, long-lived.
    location /api/protect-meta/stream {
        proxy_pass http://127.0.0.1:$APP_PORT;
        include /etc/nginx/snippets/xdp-sentinel-proxy.conf;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:$APP_PORT;
        include /etc/nginx/snippets/xdp-sentinel-proxy.conf;
    }
}
EOF
install -d /etc/nginx/snippets
cat > /etc/nginx/snippets/xdp-sentinel-proxy.conf <<EOF
proxy_http_version 1.1;
# Host WITH the port, so the app's absolute redirects keep :$PORT.
proxy_set_header Host              \$http_host;
# Overwrite (not append) the client address: the app trusts this header for the
# audit log and the per-IP sign-in lock, so a browser must not be able to set it.
proxy_set_header X-Forwarded-For   \$remote_addr;
proxy_set_header X-Real-IP         \$remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host  \$http_host;
proxy_set_header Connection        "";
# The app answers with http:// URLs in redirects; give the browser https://.
proxy_redirect http://\$http_host/ https://\$http_host/;
EOF
ln -sf "$SITE" /etc/nginx/sites-enabled/xdp-sentinel
nginx -t >/dev/null 2>&1 || { nginx -t; die "nginx config test failed (nothing changed yet)."; }

# ---- move the app to 127.0.0.1:$APP_PORT, then let nginx take :$PORT -------------
install -d "$DROPIN_DIR"
cat > "$DROPIN" <<EOF
# Managed by xs-https-setup: the dashboard listens only on loopback; nginx
# serves it to the network over HTTPS on :$PORT.
[Service]
ExecStart=
ExecStart=/usr/bin/npm run start -- -p $APP_PORT -H 127.0.0.1
Environment=DASH_INTERNAL_URL=http://127.0.0.1:$APP_PORT
EOF
systemctl daemon-reload
systemctl restart "$DASH_UNIT"
wait_port "$APP_PORT" || die "the dashboard did not come up on 127.0.0.1:$APP_PORT (journalctl -u $DASH_UNIT). Undo: $0 --rollback"
ok "dashboard now on 127.0.0.1:$APP_PORT (loopback only)"
systemctl enable nginx >/dev/null 2>&1 || true
systemctl restart nginx
sleep 1
code=$(curl -s -o /dev/null -w '%{http_code}' --cacert "$CA_CRT" "https://127.0.0.1:$PORT/login" || true)
[ "$code" = 200 ] && ok "HTTPS answering on :$PORT (login page $code)" || warn "HTTPS check on :$PORT returned '$code' — see: journalctl -u nginx"
redir=$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' "http://127.0.0.1:$PORT/login" || true)
info "plain http on :$PORT -> $redir"

# ---- kiosk display: use the local app directly -------------------------------
if [ -f "$KIOSK" ] && grep -q "/api/kiosk" "$KIOSK"; then
  sed -i -E "s#https?://[^/\"' ]+/api/kiosk#$KIOSK_LOCAL/api/kiosk#" "$KIOSK"
  pkill -u test_server -x firefox 2>/dev/null && ok "kiosk restarted on $KIOSK_LOCAL" || ok "kiosk launcher points at $KIOSK_LOCAL"
fi

# ---- monthly certificate renewal ------------------------------------------------
install -m0755 "$0" /usr/local/sbin/xs-https-setup 2>/dev/null || true
cat > /etc/systemd/system/xs-https-renew.service <<UNIT
[Unit]
Description=Renew the xdp-sentinel dashboard HTTPS certificate when due
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xs-https-setup --renew --port $PORT --app-port $APP_PORT --tls-dir $TLS_DIR
UNIT
cat > /etc/systemd/system/xs-https-renew.timer <<UNIT
[Unit]
Description=Monthly check of the dashboard HTTPS certificate
[Timer]
OnCalendar=monthly
Persistent=true
RandomizedDelaySec=6h
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now xs-https-renew.timer >/dev/null 2>&1 && ok "certificate renewal timer enabled (monthly)"

# ---- the box trusts its own CA (local tools stop warning) ---------------------
if command -v update-ca-certificates >/dev/null 2>&1; then
  install -m0644 "$CA_CRT" /usr/local/share/ca-certificates/xdp-sentinel-ca.crt && update-ca-certificates >/dev/null 2>&1 || true
fi

echo
ok "Open https://<box-ip>:$PORT  (e.g. https://192.168.1.193:$PORT)"
info "Trust the local CA ONCE per device so the browser stops warning:"
info "  download:  https://<box-ip>:$PORT/xdp-sentinel-ca.crt   (accept the warning this one time)"
info "  macOS:     sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain xdp-sentinel-ca.crt"
info "  Windows:   certutil -addstore -f Root xdp-sentinel-ca.crt          (as administrator)"
info "  Linux:     sudo cp xdp-sentinel-ca.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates"
info "  Firefox:   Settings > Privacy & Security > Certificates > View > Authorities > Import"
info "Undo: sudo $0 --rollback"
